# NOTE:
# The previous rule `*` would ignore EVERYTHING, including any new source code.
# We keep design docs tracked, but allow normal development files/folders.
*
# Allow git config files at root
!.gitattributes
!.gitignore
# Claude Code settings (local only, do not commit)
.claude/
# Keep backend
!backend/
!backend/**
# Allow frontend-matching
!frontend-matching/
!frontend-matching/**
# Common build/output folders
**/build/
**/out/
**/.vs/
**/.vscode/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/*.user
**/*.log

# vcpkg (if you choose to keep it inside the repo)
vcpkg_installed/

# OS / IDE
.DS_Store
Thumbs.db

# Ignore based on frontend-matching/.gitignore
frontend-matching/logs
frontend-matching/*.log
frontend-matching/npm-debug.log*
frontend-matching/yarn-debug.log*
frontend-matching/yarn-error.log*
frontend-matching/pnpm-debug.log*
frontend-matching/lerna-debug.log*
frontend-matching/node_modules
frontend-matching/dist
frontend-matching/dist-ssr
frontend-matching/*.local
frontend-matching/.vscode/*
!frontend-matching/.vscode/extensions.json
frontend-matching/.idea
frontend-matching/.DS_Store
frontend-matching/*.suo
frontend-matching/*.ntvs*
frontend-matching/*.njsproj
frontend-matching/*.sln
frontend-matching/*.sw?

# Keep scripts
!scripts/
!scripts/**

# Allow new frontend subdirectories
!frontend-matching/src/components/
!frontend-matching/src/components/**
!frontend-matching/src/composables/
!frontend-matching/src/composables/**
!frontend-matching/src/layouts/
!frontend-matching/src/layouts/**

# Ignore Windows Zone.Identifier ADS files (including mangled Unicode versions)
*Zone.Identifier*

# Docker-built binaries (not portable)
backend/build-linux/

# Keep documentation files
!bug_report.md
!系统设计说明书.docx
!需求分析.md
!readme.md
!系统设计说明书_简版.md
!docs
!docs/**

**/开发总结*